[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://tools/DebugMain.gd" id="1"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 60
theme_override_constants/margin_top = 60
theme_override_constants/margin_right = 60
theme_override_constants/margin_bottom = 60

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "《山河信使》· 地基冒烟测试"
horizontal_alignment = 1

[node name="InfoLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
autowrap_mode = 2

[node name="Hint" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "点「模拟集齐碎片」验证：解锁下一站 → 存档 → 重启工程后进度保留"
autowrap_mode = 2

[node name="StationList" type="VBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="DialogueButton" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "测试对话场景（丽江问路）"

[node name="ResetButton" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "重开新档（清空存档）"

[connection signal="pressed" from="Panel/Margin/VBox/DialogueButton" to="." method="_on_dialogue_button_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/ResetButton" to="." method="_on_reset_button_pressed"]
