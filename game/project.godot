; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="山河信使 · 技术分享"
config/description="茶马古道·山河信使 — 影游+文化解谜 Demo（2026 数媒竞赛）"
config/version="0.1.2-public"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://autoload/GameState.gd"
SceneRouter="*res://autoload/SceneRouter.gd"
GameSettings="*res://autoload/GameSettings.gd"
GameMusic="*res://autoload/GameMusic.gd"
JourneyFlow="*res://autoload/JourneyFlow.gd"
GameUI="*res://autoload/GameUI.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray("res://addons/runtime_glb_export/plugin.cfg")

[gui]

theme/custom="res://assets/shared/fonts/ui_theme.tres"

[rendering]

textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
