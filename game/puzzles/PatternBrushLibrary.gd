extends RefCounted
## 可组合的纹样曲线笔法。模型选择笔法和顺序，避免现场猜几何坐标导致畸形。
static func e(x: float, y: float, rx: float, ry: float, a: float = 0) -> Dictionary:
	return {"op":"ellipse", "x":x, "y":y, "rx":rx, "ry":ry, "a":a}

static func p(points: Array) -> Dictionary:
	return {"op":"path", "p":points}

static func leaf(x: float, y: float, length: float, width: float, angle: float) -> Dictionary:
	return {"op":"petal", "x":x, "y":y, "l":length, "w":width, "a":angle}

static func flower(x: float, y: float, radius: float, petals: int, angle: float = -90) -> Dictionary:
	return {"op":"flower", "x":x,"y":y,"r":radius,"petals":petals,"a":angle}

